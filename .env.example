# This is required to run the AI APIs.
# Copy this file to another file called .env 
# and fill in your own keys.

# Get a Gemini key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR-API-KEY

# Get a Claude key here: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR-API-KEY

